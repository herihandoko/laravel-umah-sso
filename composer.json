{
    "name": "herihandoko/laravel-umah-sso",
    "description": "Pintu Umah SSO client for Laravel apps (Provinsi Banten)",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "sso",
        "pintu-umah",
        "bantenprov",
        "umah"
    ],
    "authors": [
        {
            "name": "Heri Handoko",
            "email": "hery.handoko@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": ">=10.0",
        "illuminate/http": ">=10.0",
        "illuminate/auth": ">=10.0",
        "illuminate/routing": ">=10.0"
    },
    "autoload": {
        "psr-4": {
            "Herihandoko\\UmahSso\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Herihandoko\\UmahSso\\UmahSsoServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
